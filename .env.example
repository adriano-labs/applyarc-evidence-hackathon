# Copy to .env and start with: node --env-file=.env server/index.js
# Keys stay on the server and never reach the browser. Never commit .env.

# fixture (the default: hand-written outputs, no keys), meta or compatible
PROVIDER=fixture

# PROVIDER=meta: Muse Spark 1.3 or Wonder 1.0 through Meta's Responses API
META_API_KEY=
# Optional: META_MODEL defaults to muse-spark-1.3; set to muse-wonder-1.0 for Meta Muse Wonder 1.0
# META_MODEL=muse-spark-1.3
# Optional override: META_REASONING_EFFORT in {low, medium, high, max}
# Omit to preserve each step's existing effort. Higher effort can increase wait and cost:
# META_REASONING_EFFORT=high

# PROVIDER=compatible: Muse Spark Open on an OpenAI-compatible host
# Modal: your endpoint's /v1 URL, COMPAT_MODEL=meta-models/Muse-Spark-Open-816B-A42B
# Baseten: COMPAT_BASE_URL=https://inference.baseten.co/v1, COMPAT_MODEL=meta-models/muse-spark-open-1026
COMPAT_BASE_URL=
COMPAT_API_KEY=
COMPAT_MODEL=
COMPAT_PRICE_AS=muse-spark-1.3
COMPAT_WIRE=chat
COMPAT_STRUCTURED=1

# Application reservation threshold in USD (default 2); input tokens are estimated.
# Keep headroom below provider credit: this is not an exact provider billing ceiling.
SPEND_CAP_USD=2

# Optional
PORT=3000
DATA_DIR=data
