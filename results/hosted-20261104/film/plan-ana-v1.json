 "narration": [
  {
   "start": 0.0,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/films/ana-v1/takes/line-01.wav",
   "text": "I'm Adrian, founder of ApplyArc, a UK job-search startup that existed before this hackathon. Everything here was built during it, on Meta's models.",
   "cue": "1",
   "line": 1,
   "seconds": 9.693,
   "note": "founder: narration-20261104-134849Z.wav segment 1, cleaned by narrate-swap-ana.py"
  },
  {
   "start": 10.043,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/films/ana-v1/takes/line-02.wav",
   "text": "A real council job advert says: \"Using AI? Please follow our guidance to ensure your application reflects your own knowledge and experience.\"",
   "cue": "2",
   "line": 2,
   "seconds": 8.941,
   "note": "founder: narration-20261104-134849Z.wav segment 2, cleaned by narrate-swap-ana.py"
  },
  {
   "start": 19.135,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/films/ana-v1/takes/line-03.wav",
   "text": "Ana is fictional. Her problem is real. Three years in a Leeds care home, working English every day, and a form that wants written English.",
   "cue": "3",
   "line": 3,
   "seconds": 8.907,
   "note": "founder: narration-20261104-134849Z.wav segment 3, cleaned by narrate-swap-ana.py"
  },
  {
   "start": 28.192,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/films/ana-v1/takes/line-04.wav",
   "text": "She says it in Portuguese.",
   "cue": "4",
   "line": 4,
   "seconds": 2.605,
   "note": "founder: narration-20261104-134849Z.wav segment 4, cleaned by narrate-swap-ana.py"
  },
  {
   "start": 30.897,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/audio/ana-notes-6.0s-ba636530ebbf.wav",
   "seconds": 6.0,
   "cue": "ana-notes",
   "text": "Ana (synthetic voice, in Portuguese): “Chamo-me Ana. Eu trabalho há três anos num lar em Leeds…”",
   "note": "Ana's notes clip: the first 6.0 s of ana-pt-notes.wav (sha256 ba636530ebbf…), on the player running (notes-play)",
   "anchor": {
    "recording": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/runs/live-7/main/02-ana-speaks/recording.json",
    "ms": 1867
   }
  },
  {
   "start": 37.547,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/films/ana-v1/takes/line-05.wav",
   "text": "Muse Voice Transcribe writes it down, live, keeping her English care words in English. She checks her words first.",
   "cue": "5",
   "line": 5,
   "seconds": 7.554,
   "note": "founder: narration-20261104-134849Z.wav segment 5, cleaned by narrate-swap-ana.py"
  },
  {
   "start": 45.252,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/films/ana-v1/takes/line-06.wav",
   "text": "Muse Wonder turns her words into facts. Each one quotes her exact Portuguese. Code checks it, word for word. The English meaning sits underneath. She confirms both.",
   "cue": "6",
   "line": 6,
   "seconds": 10.677,
   "note": "founder: narration-20261104-134849Z.wav segment 6, cleaned by narrate-swap-ana.py"
  },
  {
   "start": 56.574,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/films/ana-v1/takes/line-07.wav",
   "text": "Wonder checks the council's ten points and finds the one she didn't cover: dignity and respect. It asks in Portuguese.",
   "cue": "7",
   "line": 7,
   "seconds": 7.281,
   "note": "founder: narration-20261104-134849Z.wav segment 7, cleaned by narrate-swap-ana.py"
  },
  {
   "start": 63.955,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/audio/ana-answer-4.0s-91b684c57fb5.wav",
   "seconds": 4.0,
   "cue": "ana-answer",
   "text": "Ana (synthetic voice, in Portuguese): “Para mim, dignidade é bater à porta antes de entrar…”",
   "note": "Ana's answer clip: the first 4.0 s of ana-pt-answer.wav (sha256 91b684c57fb5…), on Hearing her answer… (answer-clip)",
   "anchor": {
    "recording": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/runs/live-7/main/06-question-and-answer/recording.json",
    "ms": 11568
   }
  },
  {
   "start": 73.481,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/films/ana-v1/takes/line-08.wav",
   "text": "Wonder drafts her supporting evidence and a short letter, in English. Every factual sentence cites a fact she confirmed, and a second Wonder call checks it against her Portuguese.",
   "cue": "8",
   "line": 8,
   "seconds": 11.729,
   "note": "founder: narration-20261104-134849Z.wav segment 8, cleaned by narrate-swap-ana.py"
  },
  {
   "start": 85.36,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/films/ana-v1/takes/line-09.wav",
   "text": "Then she remembers: only two of her three years were nights. She says it once.",
   "cue": "9",
   "line": 9,
   "seconds": 7.715,
   "note": "founder: narration-20261104-134849Z.wav segment 9, cleaned by narrate-swap-ana.py"
  },
  {
   "start": 93.175,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/audio/ana-correction-4.0s-351de469faec.wav",
   "seconds": 4.0,
   "cue": "ana-correction",
   "text": "Ana (synthetic voice, in Portuguese): “Correção: os turnos da noite foram dois anos, não três…”",
   "note": "Ana's correction clip: the first 4.0 s of ana-pt-correction.wav (sha256 351de469faec…), on her correction (correction-play)",
   "anchor": {
    "recording": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/runs/live-7/main/10-her-correction/recording.json",
    "ms": 4109
   }
  },
  {
   "start": 101.679,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/films/ana-v1/takes/line-10.wav",
   "text": "Wonder spots the contradiction and asks which is right. She picks the correction. Only the sentences that cited the old fact reopen, in both documents.",
   "cue": "10",
   "line": 10,
   "seconds": 9.711,
   "note": "founder: narration-20261104-134849Z.wav segment 10, cleaned by narrate-swap-ana.py"
  },
  {
   "start": 118.098,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/films/ana-v1/takes/line-11.wav",
   "text": "Nothing gets submitted for her: the pack is stamped NOT SUBMITTED. The employer gets one page where every factual sentence opens her Portuguese words.",
   "cue": "11",
   "line": 11,
   "seconds": 11.417,
   "note": "founder: narration-20261104-134849Z.wav segment 11, cleaned by narrate-swap-ana.py"
  },
  {
   "start": 129.665,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/films/ana-v1/takes/line-12.wav",
   "text": "What Meta did, step by step: model, host and Meta's request ids. Both models are weeks old. A verifier re-checks the record without calling a model.",
   "cue": "12",
   "line": 12,
   "seconds": 11.389,
   "note": "founder: narration-20261104-134849Z.wav segment 12, cleaned by narrate-swap-ana.py"
  },
  {
   "start": 141.865,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/films/ana-v1/takes/line-13.wav",
   "text": "The same loop runs on Meta's open weights, Muse Spark Open, on Modal, so a care provider chooses where it runs.",
   "cue": "13",
   "line": 13,
   "seconds": 9.601,
   "note": "founder: narration-20261104-134849Z.wav segment 13, cleaned by narrate-swap-ana.py"
  },
  {
   "start": 151.617,
   "audio": "~/Developer/claude/evidence/hackathon-29oct/film-v15/ana/films/ana-v1/takes/line-14.wav",
   "text": "That's ApplyArc Evidence. Who pays? Councils and care employers who need applications in the applicant's own words. It never screens, ranks or submits anything.",
   "cue": "14",
   "line": 14,
   "seconds": 10.416,
   "note": "founder: narration-20261104-134849Z.wav segment 14, cleaned by narrate-swap-ana.py"
  }
 ],
